# ===================================================
# WALLY BOT - VARIABLES DE ENTORNO (COOLIFY / LOCAL)
# ===================================================

# Puerto de la aplicación
PORT=3000
NODE_ENV=production

# ---------------------------------------------------
# OPCIÓN A: Conexión mediante DATABASE_URL (Recomendado en Coolify / Supabase)
# Ejemplo: postgresql://postgres:password123@postgres-service:5432/wally_bot
# ---------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------
# OPCIÓN B: Conexión mediante Parámetros Individuales
# ---------------------------------------------------
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=wally_bot
DB_SSL=false

# ---------------------------------------------------
# Configuración de Seguridad de Envíos WhatsApp
# ---------------------------------------------------
DEFAULT_DELAY_SECONDS=30
